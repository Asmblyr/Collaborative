{
  "name": "@asmblyr-collaborative/sdk",
  "version": "0.1.0-beta.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@asmblyr-collaborative/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "description": "Typed HTTP and fluent collection client for Asmblyr",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asmblyr/Collaborative.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Asmblyr/Collaborative/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
