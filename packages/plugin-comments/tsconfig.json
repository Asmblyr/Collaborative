{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "jsx": "react-jsx",
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "types": [],
    "resolveJsonModule": true
  },
  "include": [
    "plugin.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx"
  ]
}
