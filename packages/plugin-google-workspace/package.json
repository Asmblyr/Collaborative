{
  "name": "@asmblyr-collaborative/plugin-google-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json",
    "./routes": "./dist/routes.json",
    "./collections": "./dist/collections.json"
  },
  "scripts": {
    "build": "asmblyr-plugin build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asmblyr-collaborative/contracts": "workspace:*",
    "@asmblyr-collaborative/kit": "workspace:*",
    "h3": "2.0.1-rc.32"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "asmblyr": {
    "manifest": {
      "version": 1,
      "namespace": "google",
      "capabilities": [
        "connections.google"
      ]
    }
  },
  "license": "MIT"
}
