{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["publicUrl", "existingSecret", "image", "images", "core", "ui"],
  "properties": {
    "coreSecretFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "secretName"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "secretName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://[^/]+/?$"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "sessionCookiePrefix": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]{1,40}$"
    },
    "coreEnv": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "core": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
