# Private runtime configuration for the single UI + Core image.
# PostgreSQL and S3 are external services, not included in this image.
DATABASE_URL=
ASMBLYR_SETUP_TOKEN=
AUTH_UI_URL=https://admin.example.com
SECRETS_LOCAL_KEY=

# Optional S3. Alternatively configure it in the administration interface.
# FILES_STORAGE=s3
# FILES_BUCKET=
# FILES_S3_ENDPOINT=
# FILES_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional cookie namespace for installations sharing a hostname.
# SESSION_COOKIE_PREFIX=asmblyr

# Remaining Core options are documented in apps/core/.env.example.
