# Private runtime configuration for the Core container.
# PostgreSQL and S3 are external services, not included in this image.
DATABASE_URL=
ASMBLYR_SETUP_TOKEN=
AUTH_UI_URL=https://admin.example.com
SECRETS_LOCAL_KEY=

# Optional S3. Alternatively configure it in the administration interface.
# FILES_STORAGE=s3
# FILES_BUCKET=
# FILES_S3_ENDPOINT=
# FILES_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional cookie namespace for installations sharing a hostname.
# SESSION_COOKIE_PREFIX=asmblyr
# Optional shared session for trusted applications under one parent domain.
# Only the main session cookie is shared; use HTTPS in production.
# SESSION_COOKIE_DOMAIN=example.com
# Optional old public origins, comma-separated. Route all alias paths to Core.
# AUTH_UI_ALIASES=https://old-admin.example.com

# Remaining Core options are documented in apps/core/.env.example.

# Trust only the actual reverse proxy CIDRs, with network isolation.
# TRUST_PROXY=10.244.1.0/24
