PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://asmblyr:asmblyr_dev@127.0.0.1:5433/asmblyr
# Set to a random secret (32+ characters) before creating the first superuser in the UI.
ASMBLYR_SETUP_TOKEN=

# Exact public UI origin. Required in production for passkeys; HTTP only on localhost.
AUTH_UI_URL=http://localhost:3000
# Optional RP ID must equal the UI hostname. Changing the domain requires new passkeys.
# PASSKEY_RP_ID=localhost
# Shared database limits per user; model calls also have fixed per-turn bounds.
# ASSISTANT_DAILY_REQUESTS=100
# ASSISTANT_CONCURRENT_REQUESTS=2
# 0 retains business history; 1..3650 explicitly enables bounded daily-age cleanup.
# HISTORY_RETENTION_DAYS=0

# Optional interactive SSO. Provider keys are stable and become part of the callback URL.
# AUTH_PROVIDERS=gitlab
# AUTH_UI_URL=http://localhost:3000
# AUTH_GITLAB_DRIVER=openid
# AUTH_GITLAB_LABEL=GitLab
# Issuer base URL, NOT the /.well-known/openid-configuration document.
# AUTH_GITLAB_ISSUER_URL=https://gitlab.com
# AUTH_GITLAB_CLIENT_ID=
# AUTH_GITLAB_CLIENT_SECRET=
# AUTH_GITLAB_SCOPE=openid profile email
# GitLab.com: use client_secret_post. Other providers may use client_secret_basic (default).
# AUTH_GITLAB_CLIENT_AUTH_METHOD=client_secret_post
# Register http://localhost:3000/sign/sso/gitlab/callback in the provider application.
# OAuth2 alternative (profile endpoint must return a stable account ID):
# AUTH_GITLAB_DRIVER=oauth2
# AUTH_GITLAB_AUTHORIZE_URL=https://gitlab.com/oauth/authorize
# AUTH_GITLAB_ACCESS_URL=https://gitlab.com/oauth/token
# AUTH_GITLAB_PROFILE_URL=https://gitlab.com/api/v4/user
# AUTH_GITLAB_IDENTIFIER_KEY=id
# AUTH_GITLAB_SCOPE=read_user

# Optional outbound OAuth/OpenID Connect provider (separate from inbound AUTH_PROVIDERS).
# Generate once from the repository root: node scripts/create-oauth-keys.mjs
# OAUTH_ISSUER_URL=https://admin.example.com/oauth
# OAUTH_KEYS_FILE=../../.local-data/oauth-keys.json
# Keep the key file secret and backed up; never regenerate over an existing installation.

# Optional AI assistant. No key = no assistant widget. Record comments belong to the comments plugin.
# Keep credentials and routing in Core. Never expose these via NEXT_PUBLIC_*.
# ASSISTANT_ENABLED=true
OPENAI_API_KEY=
OPENAI_API_MODEL=
# Default endpoint uses the Responses API. Set the model available to your account.
# OPENAI_API_BASE_URL=https://api.openai.com/v1/
# OPENAI_API_MODE=responses
# OPENAI_API_TIMEOUT_MS=180000
# OPENAI_API_MAX_OUTPUT_TOKENS=4096
# Defaults for the UI session; the UI may choose supported reasoning settings per request.
# OPENAI_API_MODEL_EFFORT=high
# For Z.ai GLM-5.3 (Chat Completions, mandatory thinking, low/high/max effort):
# Regular API balance:
# OPENAI_API_BASE_URL=https://api.z.ai/api/paas/v4/
# GLM Coding Plan subscription:
# OPENAI_API_BASE_URL=https://api.z.ai/api/coding/paas/v4/
# OPENAI_API_MODEL=glm-5.3
# OPENAI_API_MODE=chat-completions
# OPENAI_API_MODEL_THINKING=true

# Files are optional. Without a driver, metadata remains available and uploads return 503.
# FILES_STORAGE=yandex
# FILES_BUCKET=your-private-bucket
# FILES_YC_SERVICE_ACCOUNT_ID=your-yc-service-account-id
# Production: rotating projected Kubernetes OIDC token, exchanged for IAM in memory.
# FILES_YC_TOKEN_SOURCE=file
# FILES_YC_TOKEN_FILE=/var/run/secrets/asmblyr/storage/token
# Local development: request a short-lived Kubernetes token through your existing kubeconfig.
# FILES_YC_TOKEN_SOURCE=kubernetes
# FILES_KUBECONFIG=C:/Users/your-name/.kube/config-asmblyr
# FILES_K8S_NAMESPACE=asmblyr-collaborative-dev
# FILES_K8S_SERVICE_ACCOUNT=core-files
# FILES_YC_AUDIENCE=asmblyr-collaborative-files

# Other S3-compatible providers use the official AWS SDK credential chain.
# FILES_STORAGE=s3
# FILES_BUCKET=your-private-bucket
# FILES_S3_REGION=us-east-1
# FILES_S3_ENDPOINT=https://your-s3-endpoint
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Admin-managed connection secrets: generate this key once and back it up separately.
# SECRETS_LOCAL_KEY=<32 random bytes encoded as base64url>
# Alternative: native Yandex KMS, authenticated through Workload Identity Federation.
# YC_OIDC_TOKEN_FILE=/var/run/secrets/asmblyr/yandex/token
# Choose KMS/key/account in /admin/settings/integrations before locking the group in env.
# SECRETS_PROVIDER=yandex-kms
# SECRETS_YC_KMS_KEY_ID=your-kms-key-id
# SECRETS_YC_SERVICE_ACCOUNT_ID=your-yc-service-account-id
# FILES_STORAGE=disabled and ASSISTANT_ENABLED=false explicitly disable and lock their group.

# Optional personal Google Workspace integration (alternatively configure in admin).
# Any GOOGLE_WORKSPACE_* value locks this group in the admin UI.
# GOOGLE_WORKSPACE_ENABLED=true
# GOOGLE_WORKSPACE_CLIENT_ID=your-web-client.apps.googleusercontent.com
# GOOGLE_WORKSPACE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3000/connections/google/callback

# Optional Sentry. Leave all SENTRY_* unset to configure in /admin/settings/monitoring.
# Any nonempty SENTRY_* value locks this group; SENTRY_ENABLED=false disables and locks it.
# Core and browser can use separate Sentry projects; error collection defaults to enabled per DSN.
# SENTRY_DSN also serves the browser if SENTRY_BROWSER_DSN is unset, for compatibility.
# For Core only, set SENTRY_ERRORS_BROWSER=false and SENTRY_PERFORMANCE_BROWSER=false.
# SENTRY_ENABLED=true
# SENTRY_DSN=https://0123456789abcdef@your-sentry-host/1
# SENTRY_BROWSER_DSN=https://0123456789abcdef@your-sentry-host/2
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=collaborative@0.1.0
# SENTRY_ERRORS_CORE=true
# SENTRY_ERRORS_BROWSER=true
# SENTRY_PERFORMANCE_CORE=false
# SENTRY_PERFORMANCE_BROWSER=false
# SENTRY_DATABASE_SPANS=false
# SENTRY_TRACES_SAMPLE_RATE=0.1
