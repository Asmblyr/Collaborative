{
  "name": "@asmblyr/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"../../plugins/**/*.ts\" --include \"../../plugins/*/package.json\" --include \"../../package.json\" --exclude \"../../plugins/*/dist/**\" src/server.ts --plugin-sources",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "knex --knexfile knexfile.mjs migrate:latest",
    "db:rollback": "knex --knexfile knexfile.mjs migrate:rollback",
    "db:status": "knex --knexfile knexfile.mjs migrate:list",
    "test:integration": "node ../../scripts/test.mjs core-integration",
    "typecheck": "tsc --noEmit",
    "test:assistant": "node ../../scripts/test.mjs core-assistant",
    "lint": "eslint",
    "test": "node ../../scripts/test.mjs core-all",
    "test:unit": "node ../../scripts/test.mjs core-unit"
  },
  "dependencies": {
    "@asmblyr/contracts": "workspace:*",
    "@asmblyr/kit": "workspace:*",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@fastify/middie": "9.3.4",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "entities": "^8.1.0",
    "fastify": "^5.12.5",
    "h3": "2.0.1-rc.32",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "oidc-provider": "9.12.2",
    "openai": "^7.23.0",
    "openid-client": "6.8.8",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@asmblyr/sdk": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "license": "MIT"
}
